{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sheperd-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "HOST_ROOM", "class_name": "HostRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostRoom"] }],
  "observability": { "enabled": true }
  // Secret, set with `npx wrangler secret put HOST_TOKEN`:
  //   HOST_TOKEN  shared secret hosts present to register with this relay
}
