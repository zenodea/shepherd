<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <!-- Keeps the app (and its connection to the computer) running in the background. -->
    <service
        android:name="dev.shepherd.background.KeepAliveService"
        android:exported="false"
        android:foregroundServiceType="remoteMessaging" />
    <!-- The home-screen widget. Exported: the launcher sends it updates. -->
    <receiver
        android:name="dev.shepherd.background.ShepherdWidget"
        android:exported="true"
        android:label="@string/shepherd_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/shepherd_widget_info" />
    </receiver>
    <!-- Answer buttons on notifications. -->
    <receiver
        android:name="dev.shepherd.background.ActionReceiver"
        android:exported="false" />
  </application>
</manifest>
