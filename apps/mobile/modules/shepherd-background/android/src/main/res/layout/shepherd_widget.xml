<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: which agents need you, at a glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shepherd_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/shepherd_notification_icon"
        android:tint="#F5B544"
        android:contentDescription="@null" />
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Shepherd"
        android:textColor="#FAFAFA"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#6B6B6B"
        android:textSize="11sp" />
  </LinearLayout>

  <TextView
      android:id="@+id/widget_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="6dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Open Shepherd to connect"
      android:textColor="#FAFAFA"
      android:textSize="17sp"
      android:textStyle="bold" />

  <TextView android:id="@+id/widget_line1" style="@style/ShepherdWidgetLine" />
  <TextView android:id="@+id/widget_line2" style="@style/ShepherdWidgetLine" />
  <TextView android:id="@+id/widget_line3" style="@style/ShepherdWidgetLine" />
</LinearLayout>
