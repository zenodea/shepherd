{
  "expo": {
    "name": "Shepherd",
    "slug": "shepherd",
    "platforms": [
      "android",
      "ios"
    ],
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.shepherd.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1A2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.shepherd.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Shepherd uses Face ID to lock the app."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "shepherd uses the camera to scan the pairing QR code shown by shepherd-host.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E1A2B",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A1220"
          }
        }
      ]
    ],
    "scheme": "shepherd",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0A0A0A",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e1b3bd4-8d7f-4c7e-b5d2-08ca0da37cab"
      }
    },
    "owner": "zenodea"
  }
}
