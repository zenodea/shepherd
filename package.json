{
  "name": "sheperd",
  "private": true,
  "description": "Control your herdr agents from your phone",
  "workspaces": [
    "packages/*",
    "host",
    "relay",
    "app"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.18"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "react": "19.2.3"
  }
}
