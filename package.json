{
  "name": "shepherd",
  "license": "MIT",
  "private": true,
  "description": "Control your herdr agents from your phone",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "host": "npm start --silent -w @shepherd/host --",
    "app": "npm start -w @shepherd/mobile",
    "app:prod": "npm start -w @shepherd/mobile -- --no-dev --minify",
    "app:demo": "npm run demo -w @shepherd/mobile",
    "relay": "npm run dev -w @shepherd/relay",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.18"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": true,
    "unrs-resolver": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
